# Student_Repo Environment Configuration Template
# Duplicate this file to .env.local for local development.
# In Vercel, configure these under Settings -> Environment Variables.

# 1. Supabase Project Credentials
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Server-Side Supabase Service Role Key (Keep private, never commit)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Session Signing Secret (Minimum 32 random characters)
AUTH_SECRET=generate-a-secure-random-32-character-secret-key-here

# 4. Canonical Application URL
# Local: http://localhost:3000
# Production: https://studentrepo.vercel.app
NEXT_PUBLIC_APP_URL=https://studentrepo.vercel.app
